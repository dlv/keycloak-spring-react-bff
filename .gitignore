# Segredos e configurações locais
# Arquivos .env reais não devem ser versionados; templates são permitidos.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template

# Keystores, certificados privados e chaves. Não versionar material criptográfico.
*.jks
*.keystore
*.truststore
*.p12
*.pfx
*.pem
*.key

# Credenciais locais de provedores e ferramentas.
.aws/
.azure/
.gcloud/
**/service-account*.json
**/gcloud-service-key.json
**/.m2/settings.xml

# Configurações locais de Spring Boot.
**/application-local.yml
**/application-local.yaml
**/application-local.properties

# Logs e diagnósticos
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Arquivos temporários e de runtime
*.pid
*.pid.lock
*.seed
*.tmp
*.swp
*.swo
*~
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

